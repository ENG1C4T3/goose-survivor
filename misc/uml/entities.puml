@startuml
skinparam classAttributeIconSize 0

package "Ashley ECS Framework" {
    interface Component <<com.badlogic.ashley.core>>
    class Entity <<com.badlogic.ashley.core>> {
        + Entity add(Component component)
        + Component remove(Class<Component> componentClass)
        + T getComponent(Class<T> componentClass)
        + boolean hasComponent(Class<Component> componentClass)
    }
    class Engine <<com.badlogic.ashley.core>> {
        + void addEntity(Entity entity)
        + void removeEntity(Entity entity)
        + void addSystem(EntitySystem system)
        + void update(float deltaTime)
    }
    abstract class EntitySystem <<com.badlogic.ashley.core>> {
        + void update(float deltaTime)
    }
    abstract class IteratingSystem <<com.badlogic.ashley.systems>> {
        # void processEntity(Entity entity, float deltaTime)
        + void update(float deltaTime)
    }
    class ComponentMapper<T extends Component> <<com.badlogic.ashley.core>> {
        + {static} ComponentMapper<T> getFor(Class<T> componentClass)
        + T get(Entity entity)
        + boolean has(Entity entity)
    }
    class Family <<com.badlogic.ashley.core>> {
        + {static} Builder all(Class<? extends Component>... componentTypes)
    }

    EntitySystem <|-- IteratingSystem
    Entity o-- Component
    Engine o-- Entity
    Engine o-- EntitySystem
}

package "Components (Pure Data)" {
    class TransformComponent {
        + {static} ComponentMapper<TransformComponent> MAPPER
        + Vector2 position
    }
    Component <|.. TransformComponent

    class TextureComponent {
        + {static} ComponentMapper<TextureComponent> MAPPER
        + TextureRegion region
    }
    Component <|.. TextureComponent

    class VelocityComponent {
        + {static} ComponentMapper<VelocityComponent> MAPPER
        + Vector2 velocity
        + float maxSpeed
    }
    Component <|.. VelocityComponent

    class PlayerComponent {
        + {static} ComponentMapper<PlayerComponent> MAPPER
        ' Tag component
    }
    Component <|.. PlayerComponent

    class BoundsComponent {
        + Rectangle bounds
    }
    Component <|.. BoundsComponent

    class HealthComponent {
        + float health
        + float maxHealth
        + float damageCooldown
    }
    Component <|.. HealthComponent

    class EnemyComponent {
        + EnemyType type
        + float damage
    }
    Component <|.. EnemyComponent

    enum EnemyType {
        NORMAL_GOOSE
        FAST_GOOSE
        TANK_GOOSE
        GRADIENT_GOOSE
        LONG_BOI
    }
    EnemyComponent --> EnemyType

    class ProjectileComponent {
        + float baseDamage
    }
    Component <|.. ProjectileComponent

    class InteractableComponent {
        + float range
    }
    Component <|.. InteractableComponent

    class TriggerComponent {
        + List<TriggerListener> listeners
    }
    Component <|.. TriggerComponent
}

package "Systems (Pure Logic)" {
    class RenderSystem {
        - SpriteBatch batch
        - OrthographicCamera camera
        ' Family: all(TransformComponent, TextureComponent)
        + void update(float deltaTime)
        # void processEntity(Entity entity, float deltaTime)
    }
    IteratingSystem <|-- RenderSystem

    class MovementSystem {
        ' Family: all(TransformComponent, VelocityComponent)
        # void processEntity(Entity entity, float deltaTime)
    }
    IteratingSystem <|-- MovementSystem

    class InputSystem {
        ' Family: all(PlayerComponent, VelocityComponent)
        # void processEntity(Entity entity, float deltaTime)
    }
    IteratingSystem <|-- InputSystem

    class CollisionSystem {
        ' Family: all(TransformComponent, BoundsComponent)
        # void processEntity(Entity entity, float deltaTime)
    }
    IteratingSystem <|-- CollisionSystem

    class CombatSystem {
        ' Family: all(HealthComponent)
        # void processEntity(Entity entity, float deltaTime)
    }
    IteratingSystem <|-- CombatSystem

    class EnemyAiSystem {
        ' Family: all(EnemyComponent, TransformComponent, VelocityComponent)
        # void processEntity(Entity entity, float deltaTime)
    }
    IteratingSystem <|-- EnemyAiSystem

    class InteractionSystem {
        ' Family: all(InteractableComponent) or all(TriggerComponent)
        # void processEntity(Entity entity, float deltaTime)
    }
    IteratingSystem <|-- InteractionSystem
}

package "Entities" {
    class EntityFactory {
        + {static} Entity createPlayer(float x, float y, float speed, TextureRegion region)
    }
    EntityFactory ..> Entity : creates
    EntityFactory ..> PlayerComponent : attaches
    EntityFactory ..> TransformComponent : attaches
    EntityFactory ..> VelocityComponent : attaches
    EntityFactory ..> TextureComponent : attaches
}

' System to Component dependencies
RenderSystem ..> TransformComponent : reads via MAPPER
RenderSystem ..> TextureComponent : reads via MAPPER

MovementSystem ..> TransformComponent : writes via MAPPER
MovementSystem ..> VelocityComponent : reads via MAPPER

InputSystem ..> PlayerComponent : matches via Family
InputSystem ..> VelocityComponent : writes via MAPPER

CollisionSystem ..> BoundsComponent : reads
CollisionSystem ..> TransformComponent : reads

CombatSystem ..> HealthComponent : writes

EnemyAiSystem ..> EnemyComponent : reads
EnemyAiSystem ..> VelocityComponent : writes

InteractionSystem ..> InteractableComponent : reads
InteractionSystem ..> TriggerComponent : reads

@enduml
