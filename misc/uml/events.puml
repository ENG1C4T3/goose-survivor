@startuml

package "Components (Pure Data)" {
    class InteractableComponent {
        + float range
        + String promptText
        ' Action only, e.g. "Pick up Coffee"; HUD shows "[E] " + promptText
        + boolean singleUse
    }

    class HealOnInteractComponent {
        ' Interaction effect
        + float amount
    }

    class TriggerEventComponent {
        + Entity sourcePlayer
        + Entity targetInteractable
        + ActionType action
    }

    enum ActionType {
        INTERACT
    }
    TriggerEventComponent --> ActionType

    class UseItemEventComponent {
        + Entity user
        + int slotIndex
    }

    class ItemPickupComponent {
        ' Interaction effect
        + ItemType item
    }
}

package "Systems (Pure Logic)" {
    class InputSystem {
        ' Checks keybinds and player position
        + void update(float deltaTime)
    }

    class InteractionSystem {
        ' Processes the event logic
        + void update(float deltaTime)
    }

    class InventorySystem {
        ' Uses items, ticks cooldowns
        + void update(float deltaTime)
    }

    class EventCleanupSystem {
        ' Runs at the very end of the frame
        + void update(float deltaTime)
    }
}

' Flow of the Event-as-Entity pattern
InputSystem .right.> TriggerEventComponent : 1. Detects keypress in range\nCreates Event Entity
InteractionSystem ..> TriggerEventComponent : 2. Reads Event Entity\nExecutes game logic
EventCleanupSystem ..> TriggerEventComponent : 3. Destroys Event Entity\nat end of frame

InputSystem ..> InteractableComponent : reads range\nfindNearestInteractable()\n(also used by HUD prompt popup)
InteractionSystem ..> InteractableComponent : reads singleUse
InteractionSystem ..> HealOnInteractComponent : applies effect
InteractionSystem ..> ItemPickupComponent : adds item to inventory

InputSystem ..> UseItemEventComponent : 1. Detects key 1-9\nCreates Event Entity
InventorySystem ..> UseItemEventComponent : 2. Uses item if ready
EventCleanupSystem ..> UseItemEventComponent : 3. Destroys Event Entity
@enduml
